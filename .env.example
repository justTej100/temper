# Optional overrides — `docker compose up` works with zero config.

# DATABASE_URL=postgresql://forecast:forecast@db:5432/forecast
# (use postgresql:// — SQLAlchemy rejects the legacy postgres:// scheme)
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MODEL_STORAGE_PATH=/app/model_artifacts
# MODEL_CACHE_TTL_HOURS=24
# EDGE_THRESHOLD=0.08
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# NEXT_PUBLIC_API_URL=http://localhost:8000
# ENVIRONMENT=development
# ADMIN_TOKEN=
# MLFLOW_ENABLED=true
# MLFLOW_EXPERIMENT=temperature-predictor
# MIN_HISTORY_DAYS=365
# MAX_MISSING_DAYS=7
# MAX_FORECAST_HORIZON_DAYS=30
# BACKTEST_FOLDS=5
# HTTP_TIMEOUT_SECONDS=30
# HTTP_MAX_RETRIES=3
# TASK_SOFT_TIME_LIMIT_SECONDS=840
# TASK_TIME_LIMIT_SECONDS=900
# SCHEDULE_MINUTES=20
# Retention policy (cleanup scheduling is an operations concern):
# PREDICTION_RETENTION_DAYS=180
# EDGE_RETENTION_DAYS=180
# JOB_RETENTION_DAYS=30
# MODEL_RETENTION_DAYS=365
