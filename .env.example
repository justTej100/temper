# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://forecast:forecast@db:5432/forecast

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Model cache TTL (hours)
MODEL_CACHE_TTL_HOURS=24

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Model storage (local path or S3-compatible)
MODEL_STORAGE_BACKEND=local
MODEL_STORAGE_PATH=/app/model_artifacts
# S3-compatible (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=

# Keepa API (optional — demo mode used when unset)
KEEPA_API_KEY=

# Data source: keepa | demo
DATA_SOURCE=demo

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
