# Copy to .env only when you need overrides. Docker Compose works without it.
# Never commit a populated .env. Public data sources require no API keys.

# Runtime mode. Production validates database, queue, CORS, and admin settings.
# ENVIRONMENT=development
# PORT=8000

# Local container defaults (Render injects internal connection strings).
# DATABASE_URL=postgresql://forecast@postgres:5432/forecast
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# MLFLOW_TRACKING_URI=http://mlflow:5000
# MLFLOW_ENABLED=true
# MLFLOW_EXPERIMENT=temperature-predictor
# MODEL_STORAGE_PATH=/app/model_artifacts

# Browser-visible URL is embedded into the Next.js production build.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production-only protection for sync/training endpoints. Generate a long random value.
# ADMIN_TOKEN=

# Forecast and quality controls.
# MODEL_CACHE_TTL_HOURS=24
# EDGE_THRESHOLD=0.08
# HISTORY_DAYS=730
# MIN_HISTORY_DAYS=365
# MAX_MISSING_DAYS=7
# MAX_FORECAST_HORIZON_DAYS=30
# BACKTEST_FOLDS=5
# HTTP_TIMEOUT_SECONDS=30
# HTTP_MAX_RETRIES=3
# TASK_SOFT_TIME_LIMIT_SECONDS=840
# TASK_TIME_LIMIT_SECONDS=900
# SCHEDULE_MINUTES=20

# Public source endpoints normally do not need overriding.
# GAMMA_API_URL=https://gamma-api.polymarket.com
# OPEN_METEO_URL=https://archive-api.open-meteo.com/v1/archive
# GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# Retention targets; schedule cleanup according to operations policy.
# PREDICTION_RETENTION_DAYS=180
# EDGE_RETENTION_DAYS=180
# JOB_RETENTION_DAYS=30
# MODEL_RETENTION_DAYS=365
